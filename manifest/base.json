{
  "manifest_version": 3,
  "name": "CleanThis",
  "version": "0.6.10",
  "description": "Clean files and scan webpages with cleanthis.io \u2014 CDR file sanitization and website safety checks.",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://cleanthis.io/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CleanThis",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "tabs",
    "webNavigation"
  ]
}
